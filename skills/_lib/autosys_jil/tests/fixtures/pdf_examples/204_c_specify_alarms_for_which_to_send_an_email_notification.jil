/* extracted from PDF p.2588: Specify Alarms for Which to Send an Email Notification */
insert_job: alarm_notification
machine: localhost
job_type: c
command: as_test -t 2
send_notification:y
notification_alarm_types: JOBFAILURE, MAXRUNALARM
notification_template: emailtemplate
notification_emailaddress_on_alarm :admin@example.com
notification_emailaddress: address
