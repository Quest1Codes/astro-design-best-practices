/* extracted from PDF p.2839: Add Two Numbers Passing Two Parameters */
insert_job: incpayload
job_type: WSDOC
machine: wsmach
endpoint_URL: "http://ws1.parasoft.com/glue/calculator"
WSDL_URL: "http://soaptest.parasoft.com/calculator.wsdl"
service_name: Calculator
port_name: ICalculator
wsdl_operation: add
ws_parameter: param_name="/add", param_value=""
ws_parameter: param_name="/add/x", payload_job="getmax1"
ws_parameter: param_name="/add/y", param_value="1.00"
ws_proxy_host: 172.31.255.255
ws_proxy_port: 80
ws_proxy_user: myuser@mydomain
ws_proxy_domain: mydomain
