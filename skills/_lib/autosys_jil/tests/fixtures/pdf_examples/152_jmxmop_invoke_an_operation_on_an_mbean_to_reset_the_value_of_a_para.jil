/* extracted from PDF p.2544: Invoke an Operation on an MBean to Reset the Value of a Parameter */
insert_job: reset
job_type: JMXMOP
machine: agent
URL: "service:jmx:rmi:///jndi/rmi://localhost:9999/server"
mbean_name: "DefaultDomain:index=1,type=Config"
mbean_operation: resetmem
jmx_parameter: Integer=50
jmx_user: user_name
