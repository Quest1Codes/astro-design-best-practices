/* extracted from PDF p.2741: Set the Value of a Variable that Belongs to a Context */
insert_job: setvarv3
job_type: SNMPSET
machine: snmpagent
snmp_mib: cybermation.mib
snmp_host: host.example.com
snmp_oid: out456789
snmp_version: 3
snmp_context_name: contxtname
snmp_context_engine_id: X'cab0'
snmp_privacy: AES
snmp_privacy_user: user1
snmp_auth_protocol: MD5
snmp_value: int=8
snmp_host: host
