/* extracted from PDF p.2547: Invoke a Web Service to Get a Stock Quote */
insert_job: sq1
job_type: WSDOC
machine: wsagent
wsdl_operation: getPrice
port_name: StockQuoteServiceHttpSoap11Endpoint
service_name: StockQuoteService
endpoint_URL: "http://wsservice:8080/axis2/services/StockQuoteService"
