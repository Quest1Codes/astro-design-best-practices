ws_parameter: param_name="/getPrice",param_value=""
ws_parameter: param_name="/getPrice/symbol", param_value="ABC"
ws_global_proxy_defaults: Y
job_criteria: criteria_xpath="//ns:return", criteria_filter=".*42.*"
