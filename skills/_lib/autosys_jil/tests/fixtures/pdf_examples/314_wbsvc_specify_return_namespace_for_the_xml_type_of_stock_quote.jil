/* extracted from PDF p.2688: Specify Return Namespace for the XML Type of Stock Quote */
insert_job: quote
job_type: WBSVC
machine: localhost
owner: ejmcommander
max_run_alarm: 0
alarm_if_fail: y
send_notification: n
wsdl_url: "http://host:8080/axis/services/StockQuote?wsdl"
target_namespace: "http://ws.ca.com"
service_name: StockQuoteService
port_name: StockQuote
wsdl_operation: GetQuote
endpoint_url: "http://host:8080/axis/services/StockQuote"
web_parameter: "xsd:string=CA"
one_way: false
return_class_name: java.lang.String
return_xml_name: string
return_namespace: "http://ws.ca.com"
