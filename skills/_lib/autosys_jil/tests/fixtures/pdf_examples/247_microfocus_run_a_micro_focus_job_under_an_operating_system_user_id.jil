/* extracted from PDF p.2628: Run a Micro Focus Job Under an Operating System User ID */
insert_job: mf_job_with_os_user
job_type: MICROFOCUS
machine: mfagent
mf_server_address_type: NAME
mf_server: mfprod
mf_jcl_type: REFERENCE
mf_jcl_name: "C:\Program Files\micro focus\es-jcldemo\if.jcl"
mf_user: MFUSER01@mfprod
os_user: OSUSER@osserver
output_var: var_name="var", var_value="value", var_format="regex|xpath|jsonpath",
