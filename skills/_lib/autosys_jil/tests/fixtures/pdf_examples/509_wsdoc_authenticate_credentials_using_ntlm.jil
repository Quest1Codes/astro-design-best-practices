/* extracted from PDF p.2833: Authenticate Credentials Using NTLM */
insert_job: getmax1
job_type: WSDOC
machine: wsmach
endpoint_URL: "http://wsmach:8080/axis2/services/TestWS"
wsdl_operation: intGetMax
port_name: TestWSHttpSoap11Endpoint
service_name: TestWS
WSDL_URL: "http://wsmach:8080/axis2/services/TestWS?wsdl"
ws_conn_user: myuser@mydomain
ws_conn_domain: mydomain
ws_conn_origin: myhost.example.com
ws_authentication_order: NTLM
ws_parameter: param_name="/intGetMax", param_value=""
ws_parameter: param_name="/intGetMax/i[3]", param_value="1,4,2"
job_criteria: criteria_xpath="//ns:return", criteria_filter="4"
ws_conn_domain: origin_domain
Limits: Up to 128 characters; case-sensitive
