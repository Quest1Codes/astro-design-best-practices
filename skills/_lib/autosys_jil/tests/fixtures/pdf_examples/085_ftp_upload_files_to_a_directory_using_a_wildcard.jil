/* extracted from PDF p.2481: Upload Files to a Directory Using a Wildcard */
insert_job: FTPUPLOAD
job_type: FTP
machine: ftpagent
ftp_server_name: hprsupp
ftp_server_port: 5222
ftp_transfer_direction: UPLOAD
